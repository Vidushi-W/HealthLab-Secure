PORT=5000
MONGO_URI=your_mongo_connection_string
JWT_SECRET=your_secret

# Hugging Face (Smart Tagging)
HF_TOKEN=your_huggingface_token
# Optional overrides
# HF_MODEL=facebook/bart-large-mnli
# HF_ENDPOINT=https://router.huggingface.co/hf-inference/models/facebook/bart-large-mnli
# HF_TIMEOUT_MS=12000
# HF_TAG_SCORE_THRESHOLD=0.18

# Community AI chatbot (Groq)
GROQ_API_KEY=your_groq_api_key
# Optional: GROQ_MODEL=llama-3.1-8b-instant or llama-3.3-70b-versatile

# Gemini AI (for summaries and research help)
GEMINI_API_KEY=your_gemini_api_key
# Optional: GEMINI_MODEL=gemini-2.0-flash

